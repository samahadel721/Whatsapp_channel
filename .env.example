# رقم حساب واتساب الذي سيعمل عليه البوت، بصيغة دولية بدون + أو مسافات.
# مثال رقم مصري يبدأ 015: 2015xxxxxxxxx
PHONE_NUMBER=

# true مناسب للتابلت لأنه لا يحتاج كاميرا أو جهازًا ثانيًا.
# اتركه true في أول تشغيل.
USE_PAIRING_CODE=true

# ID القناة التي سيُعاد النشر إليها، مثل:
# 1203xxxxxxxxxxxx@newsletter
# أو الصق رابطًا عامًا لقناة: https://whatsapp.com/channel/0029...
# أو رابط دعوة لجروب: https://chat.whatsapp.com/...
TARGET_CHANNEL=

# IDs أو روابط القنوات/الجروبات المطلوب مراقبتها، مفصولة بفاصلة.
# القناة الرسمية غالبًا تنتهي بـ @newsletter، والجروب ينتهي بـ @g.us
MONITORED_CHANNELS=

# true لاكتشاف IDs فقط. بعد نسخ IDs إلى الأعلى، غيّرها إلى false للتشغيل.
DISCOVERY_MODE=true

# true يحتفظ بنسخة من الوسائط داخل downloads. غيّره إلى false لتوفير مساحة التابلت.
SAVE_DOWNLOADS=true

# مدة انتظار إعادة الاتصال عند انقطاع الإنترنت.
RECONNECT_DELAY_MS=5000

# اخفاء رسائل Baileys التفصيلية. استخدم info فقط لو نحتاج تشخيصًا.
LOG_LEVEL=warn
